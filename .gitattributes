* text=auto eol=lf

# Count application source as Python (the language GitHub should show)
*.py linguist-language=Python linguist-detectable

# Django HTML templates are presentation, not the primary language.
# Leaving them in stats makes GitHub label the repo as HTML and can hide a useful language bar.
templates/** linguist-documentation
*.html -linguist-detectable

# Keep third-party / generated trees out of stats
venv/** linguist-vendored
.venv/** linguist-vendored
static/** linguist-vendored
**/__pycache__/** linguist-generated
*.sqlite3 linguist-generated
