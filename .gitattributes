* text=auto eol=lf

# Application source — this is what the GitHub language bar should show
*.py linguist-language=Python linguist-detectable=true

# Django templates are UI markup. Unset-style (-linguist-detectable) returns to
# Linguist's default, which still counts HTML. Explicit false is required.
*.html linguist-detectable=false
templates/** linguist-documentation

# Keep third-party / generated trees out of stats
venv/** linguist-vendored
.venv/** linguist-vendored
static/** linguist-vendored
**/__pycache__/** linguist-generated
*.sqlite3 linguist-generated
